{
  "$description": "Contour XR design system tokens. Version 0.2.0. Two layers: primitives (family.step) and aliases (family.role.variant.state.property.bound). Things the eye judges are in vpt (view points); things the hand or body reaches are in metres. Format follows the W3C Design Tokens (DTCG) layout. See docs/tokens.md.",
  "$extensions": {
    "com.contour": {
      "version": "0.2.0",
      "units": {
        "vpt": "view point: 0.75 mm of real size per metre of viewing distance (0.75 dmm, about 0.043 degrees). Real size (m) = vpt x 0.00075 x f(d), with d measured once when the panel is placed. Used for everything the eye judges.",
        "m": "real physical metre. Used for everything the hand or body reaches. Docs and Figma show cm, or mm below 1 cm.",
        "deg": "angle from the viewer's eye",
        "ms": "milliseconds",
        "dmm": "legacy: mm at 1 m viewing distance. No token uses it since v0.2."
      },
      "viewSize": "real size (m) = vpt x 0.00075 x f(d); f(d) = d up to zone.room.growth.start, then start + rate x (d - start)"
    }
  },
  "thickness": {
