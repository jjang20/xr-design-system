        }
      },
      "falloff": {
        "$type": "string",
        "$value": "cosine",
        "$description": "Curve that fades magnification for neighbouring icons: scale = 1 + (max - 1) * cos(d / radius * pi/2).",
        "$extensions": {
          "com.contour": {
            "evidence": "G",
            "category": "Proximity"
          }
        }
      }
    }
