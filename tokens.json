{
  "$description": "Contour XR design system tokens. Version 0.1.0. Scene space is real-world 1:1 (1 unit = 1 m). Format follows the W3C Design Tokens (DTCG) layout, with three XR units added: dmm, mm and deg. See docs/tokens.md.",
  "$extensions": {
    "com.contour": {
      "version": "0.1.0",
      "units": {
        "dmm": "distance-independent millimetre: mm at 1 m viewing distance, scaled linearly with the real placement distance (the 'rem' of XR)",
        "mm": "real physical millimetre (things the hand touches)",
        "deg": "angle from the viewer's eye"
      }
    }
  },
  "material": {
    "t": {
      "thin": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "mm"
        },
        "$description": "Thickness for cards and list items.",
        "$extensions": {
          "com.contour": {
            "evidence": "G",
            "category": "Material"
          }
        }
      },
      "regular": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "mm"
        },
        "$description": "Default thickness for buttons and controls.",
        "$extensions": {
          "com.contour": {
            "evidence": "G",
            "category": "Material"
          }
        }
      },
      "thick": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "mm"
        },
        "$description": "Thickness for panels and the dock.",
        "$extensions": {
          "com.contour": {
            "evidence": "G",
            "category": "Material"
          }
        }
      }
    },
    "density": {
      "soft": {
        "press": {
          "$type": "number",
          "$value": 0.6,
          "$description": "Presses deep, recovers slowly. Press depth as a fraction of material.t (press depth = ratio x t).",
          "$extensions": {
            "com.contour": {
              "evidence": "T",
              "category": "Material"
            }
          }
        },
        "recover": {
          "$type": "duration",
          "$value": {
            "value": 220,
            "unit": "ms"
          },
          "$description": "Time to spring back to full thickness after release. This is the only recover timing; motion.recover inherits it.",
          "$extensions": {
            "com.contour": {
              "evidence": "T",
              "category": "Material"
            }
          }
        }
      },
      "firm": {
        "press": {
          "$type": "number",
          "$value": 0.4,
          "$description": "Default density. Press depth as a fraction of material.t (press depth = ratio x t).",
          "$extensions": {
            "com.contour": {
              "evidence": "T",
              "category": "Material"
            }
          }
        },
        "recover": {
          "$type": "duration",
          "$value": {
            "value": 140,
            "unit": "ms"
          },
          "$description": "Time to spring back to full thickness after release. This is the only recover timing; motion.recover inherits it.",
          "$extensions": {
            "com.contour": {
              "evidence": "T",
              "category": "Material"
            }
          }
        }
      },
      "rigid": {
        "press": {
          "$type": "number",
          "$value": 0.15,
          "$description": "Barely presses. Disabled and structural elements. Press depth as a fraction of material.t (press depth = ratio x t).",
          "$extensions": {
            "com.contour": {
              "evidence": "T",
              "category": "Material"
            }
          }
        },
        "recover": {
          "$type": "duration",
          "$value": {
            "value": 80,
            "unit": "ms"
          },
          "$description": "Time to spring back to full thickness after release. This is the only recover timing; motion.recover inherits it.",
          "$extensions": {
            "com.contour": {
              "evidence": "T",
              "category": "Material"
            }
          }
        }
      }
    }
  },
  "proximity": {
    "hover": {
      "enter": {
        "$type": "dimension",
        "$value": {
          "value": 100,
          "unit": "dmm"
        },
        "$description": "Hover starts when the hand comes closer than this.",
        "$extensions": {
          "com.contour": {
            "evidence": "G",
            "category": "Proximity"
          }
        }
      },
      "exit": {
        "$type": "dimension",
        "$value": {
          "value": 140,
          "unit": "dmm"
        },
        "$description": "Hover ends only when the hand moves further than this (hysteresis band 100-140).",
        "$extensions": {
          "com.contour": {
            "evidence": "G",
            "category": "Proximity"
          }
        }
      }
    },
    "poke": {
      "press": {
        "$type": "string",
        "$value": "surface-contact",
        "$description": "A press starts when the fingertip touches the surface; depth then follows material.density.*.press.",
        "$extensions": {
          "com.contour": {
            "evidence": "N",
            "category": "Proximity"
          }
        }
      },
      "release": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "mm"
        },
        "$description": "Release only after the finger retreats this far back from the press point (release hysteresis, stops jitter).",
        "$extensions": {
          "com.contour": {
            "evidence": "T",
            "category": "Proximity"
          }
        }
      }
    },
    "nearfar": {
      "threshold": {
        "$type": "dimension",
        "$value": {
          "value": 350,
          "unit": "mm"
        },
        "$description": "Closer than this: ray off, direct poke on.",
        "$extensions": {
          "com.contour": {
            "evidence": "G",
            "category": "Proximity"
          }
        }
      },
      "hysteresis": {
        "$type": "dimension",
        "$value": {
          "value": 50,
          "unit": "mm"
        },
        "$description": "Plus/minus band around the near/far threshold to stop flicker.",
        "$extensions": {
          "com.contour": {
            "evidence": "G",
            "category": "Proximity"
          }
        }
      }
    }
  },
  "dock": {
