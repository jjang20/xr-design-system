{
  "name": "contour-xr",
  "version": "0.2.0",
  "private": true,
  "description": "Contour, an XR-only design system: tokens and three.js + WebXR components.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "vite",
    "dev:headset": "vite --mode headset",
    "build": "npm run check && vite build",
    "test": "npm run check && node --import ./test/support/register.mjs --disable-warning=THREE_CJS_DEPRECATED --test test/*.test.js && node --test arena/test/*.test.mjs",
    "shot": "node scripts/screenshot.mjs",
    "bench": "node scripts/bench.mjs",
    "regress": "node scripts/regress.mjs",
    "regress:quest": "node scripts/regress-quest.mjs",
    "check": "node scripts/check-tokens.mjs && node scripts/build-tokens.mjs --check",
    "build:tokens": "node scripts/check-tokens.mjs && node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "lucide-static": "1.59.0",
    "three": "0.186.1",
    "troika-three-text": "0.52.4"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "playwright-core": "1.64.1",
    "vite": "7.3.7"
  }
}
